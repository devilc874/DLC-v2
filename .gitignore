# ═══════════════════════════════════════════════════════════════
# DLC v2 — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environment
.venv/
venv/
env/

# Pytest / Hypothesis
.pytest_cache/
.hypothesis/

# ── C++ Build Artifacts ───────────────────────────────────────
cpp/build/
cpp/Testing/
*.exe
*.o
*.obj
*.lib
*.dll
*.so
*.dylib
*.a
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ── Binary Data Files (regenerated by scripts) ────────────────
# These are large binary datasets (some 24MB+). Exclude them
# and regenerate with: python test_data/generate_test_data.py
test_data/*.bin
test_data/*.dlc

# ── Compressed Output Files ───────────────────────────────────
*.dlc
output.dlc

# ── Generated Charts (can be regenerated) ─────────────────────
output/*.png

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── LaTeX Artifacts ───────────────────────────────────────────
*.aux
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# ── Archives ──────────────────────────────────────────────────
capstonev2.zip

# ── OS Files ──────────────────────────────────────────────────
*.tmp
*.log
*.bak

